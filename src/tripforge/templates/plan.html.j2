<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ m.title }} trip plan</title>
<style>
:root{--cream:#FFF8EE;--navy:#14213D;--or:#F77F00;--teal:#2A9D8F;--pur:#7B2CBF;--gold:#E9C46A;--grey:#5C6670;--card:#F4F1EA;--red:#E63946}
*{box-sizing:border-box}
body{margin:0;background:var(--cream);color:var(--navy);font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;font-size:17px;line-height:1.45}
.wrap{max-width:1000px;margin:0 auto;padding:0 18px 40px}
.hero{position:relative;color:#fff;padding:54px 0 40px;background:linear-gradient(135deg,#F77F00,#7B2CBF);overflow:hidden}
.hero.photo{background-size:cover;background-position:center}
.hero .shade{position:absolute;inset:0;background:linear-gradient(120deg,rgba(247,127,0,.78),rgba(20,33,61,.72))}
.hero .wrap{position:relative}
h1{font-size:64px;line-height:1;margin:0 0 14px;letter-spacing:-1px;text-transform:uppercase}
.sub{font-size:22px;font-weight:700;margin:4px 0}.sub2{font-size:17px;opacity:.92}
h2{font-size:26px;margin:36px 0 12px;letter-spacing:-.3px}
.decision{background:var(--navy);color:#fff;border-radius:22px;padding:24px 28px;margin-top:-22px;position:relative}
.decision .k{color:var(--gold);font-weight:700;letter-spacing:2px;font-size:14px}
.decision .big{font-size:30px;font-weight:800;margin:6px 0 10px;line-height:1.15}
.decision p{margin:0;color:#DDE6F5}
.opt{border:5px solid var(--c);border-radius:22px;background:#fff;margin:28px 0;overflow:hidden;break-inside:avoid-page}
.opt>.hd{background:var(--c);color:#fff;padding:16px 24px}
.hd .tag{font-size:14px;font-weight:700;letter-spacing:1.5px}.hd .t{font-size:28px;font-weight:800}
.body{padding:18px 24px 24px}
h3{color:var(--c);font-size:16px;letter-spacing:1px;margin:20px 0 10px;text-transform:uppercase}
.row{background:var(--card);border-radius:12px;padding:12px 16px;margin:8px 0;display:grid;grid-template-columns:110px 1fr auto;gap:6px 16px;align-items:center}
.row .fn{font-size:24px;font-weight:800}
.row .rt{font-weight:700;font-size:18px}.row .meta{color:var(--grey);font-size:14px}
.row .pr{font-size:24px;font-weight:800;color:var(--c);text-align:right}
.row.gnd{background:#eef6f5;border-left:6px solid var(--teal)}.row.gnd .fn{font-size:17px}
.row.alt{opacity:.8;background:#faf8f3}.row.alt .fn{font-size:18px}.row.alt .pr{font-size:18px}
.row.stay{grid-template-columns:1fr auto}
.row a{color:var(--c);word-break:break-all;font-size:13px}
.na{background:#fdecee;color:var(--red);border-radius:12px;padding:10px 16px;margin:8px 0;font-weight:700}
.na small{display:block;color:var(--grey);font-weight:400}
ul.plan{margin:0;padding:0;list-style:none}
ul.plan li{padding:6px 0 6px 28px;position:relative}
ul.plan li:before{content:"";position:absolute;left:4px;top:13px;width:12px;height:12px;border-radius:50%;background:var(--c)}
ul.plan b{color:var(--c)}
.totals{background:var(--c);color:#fff;border-radius:14px;padding:14px 20px;margin-top:20px}
.totals .a{font-size:21px;font-weight:800}.totals .b{font-size:15px;opacity:.95}
.card{background:#fff;border-radius:18px;padding:20px 24px;margin:16px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
.kv{display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-bottom:1px solid #eee}
.kv b{color:var(--teal);white-space:nowrap}
.lvl{display:inline-block;border-radius:8px;padding:2px 10px;color:#fff;font-weight:800}
.l1{background:var(--teal)}.l2{background:var(--gold);color:var(--navy)}.l3{background:var(--or)}.l4{background:var(--red)}
.photos{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
.photos figure{margin:0}.photos img{width:100%;height:210px;object-fit:cover;border-radius:14px}
figcaption{font-size:11px;color:var(--grey)}
.est{font-size:13px;color:var(--grey)}
.ev td,.ev th{padding:5px 8px;border-bottom:1px solid #eee;font-size:13px;text-align:left;vertical-align:top}
.ev{width:100%;border-collapse:collapse}.ok{color:var(--teal);font-weight:800}.bad{color:var(--red);font-weight:800}
a{color:var(--pur)}
@media (max-width:640px){h1{font-size:40px}.row{grid-template-columns:1fr auto}.row .fn{grid-column:1/-1}.decision .big{font-size:23px}}
@media print{@page{size:A4;margin:10mm}body{font-size:12px;background:#fff}.hero{padding:20px 0}h1{font-size:40px}.row,.card,.na,.totals,.decision,figure,tr{break-inside:avoid}.opt{break-inside:auto}h3{break-after:avoid}a{color:inherit;text-decoration:none}}
</style></head><body>

<div class="hero{% if hero %} photo{% endif %}"{% if hero %} style="background-image:url(data:image/jpeg;base64,{{ hero.b64 }})"{% endif %}>
{% if hero %}<div class="shade"></div>{% endif %}
<div class="wrap">
<h1>{{ m.title }}</h1>
<div class="sub">{{ m.people }} travellers &bull; from {{ m.home_name }} ({{ m.home }}){% if m.end_airport %} &bull; home from {{ m.end_airport }}{% endif %}{% if m.budget_night %}&bull; about {{ m.budget_night|money }} a night for stays{% endif %}</div>
<div class="sub2">{{ m.prefs|join(", ") if m.prefs else "no preferences set" }} &bull; live searches on {{ m.generated }} &bull; prices in {{ m.currency }}, per person unless stated</div>
</div></div>

<div class="wrap">
<div class="decision"><div class="k">THE DECISION</div>
{% set b = dec.best %}
{% if b %}
<div class="big">{{ plan.options|length }} option{{ "s" if plan.options|length>1 }} priced; best core cost is {{ b.start|short }} to {{ b.end|short }} at {{ b.totals.core_pp|money }} a person</div>
<p>Core cost = flights (or rail where no flight is priced) + stays share. {% for o in plan.options %}{{ o.start|short }} start: {{ o.totals.core_pp|money }}{% if o.totals.flight_legs_missing or o.totals.stays_missing %} (partial){% endif %}{{ "; " if not loop.last }}{% endfor %}. Food, drinks and tours come on top (estimates below).</p>
{% else %}
<div class="big">Some prices could not be fetched live</div>
<p>Cells marked unavailable were not fabricated. Core cost so far: {% for o in plan.options %}{{ o.start|short }} start: {{ o.totals.core_pp|money }} (partial){{ "; " if not loop.last }}{% endfor %}. Re-run with <code>--browser attach</code> if a site blocked the headless browser.</p>
{% endif %}
</div>

{% for o in plan.options %}
{% set col = ["#7B2CBF","#2A9D8F","#F77F00"][loop.index0 % 3] %}
<div class="opt" style="--c:{{ col }}">
<div class="hd"><div class="tag">OPTION {{ loop.index }}{% if dec.best and o.start == dec.best.start %} &bull; LOWEST CORE COST{% endif %}</div>
<div class="t">{{ o.stops|map(attribute="name")|join(" &rarr; ")|safe }} &nbsp; {{ o.start|day }} to {{ o.end|day }} ({{ o.nights }} nights)</div></div>
<div class="body">
<h3>Getting around (per person, one way; flights are live fare reads, rail and road rows indicative)</h3>
{% for lg in o.legs %}
 {% if lg.kind == "ground" %}
  {% set g = lg.ground %}
  <div class="row gnd"><div class="fn">{{ g.mode }}</div>
   <div><div class="rt">{{ lg.from_name }} &rarr; {{ lg.to_name }}</div>
    <div class="meta">{{ lg.date|day }} &bull; about {{ g.hours[0] }} to {{ g.hours[1] }} h &bull; ~{{ g.km }} km &bull; INDICATIVE ({{ g.source }}{% if g.mode == "ferry" and "no road" in g.source %}, no road route{% endif %}){% if g.note %} &bull; {{ g.note }}{% endif %}, book with a local operator</div></div>
   <div class="pr">{% if g.amount %}from {{ g.amount[0]|money }}{% else %}fare unavailable{% endif %}<div class="meta"><a href="{{ g.fare_url or g.link }}">12Go</a></div></div></div>
 {% elif lg.kind == "rail" %}
  {% if lg.rows %}
  {% for r in lg.rows[:3] %}
  <div class="row gnd{% if not loop.first %} alt{% endif %}"><div class="fn">Train {{ r.train }}</div>
   <div><div class="rt">{{ lg.from_name }} {{ r.dep }} &rarr; {{ lg.to_name }} {{ r.arr }}{% if r.next_day %} (+1){% endif %}</div>
    <div class="meta">{{ r.name }} &bull; {{ lg.date|day }} &bull; {{ r.duration_min|dur }} &bull; classes {{ r.classes|join(", ") or "not listed" }} &bull; INDICATIVE, check running days{% if r.early %} &bull; early departure{% endif %}{% if loop.first and lg.used %} &bull; counted in totals (fare unavailable){% endif %}{% if loop.first %} &bull; {{ lg.adapter }}, fetched {{ lg.fetched }}{% endif %}</div></div>
   <div class="pr">{% if r.fare %}{{ r.fare|money }}{% else %}fare unavailable{% endif %}<div class="meta"><a href="{{ lg.source_url }}">timetable</a></div></div></div>
  {% endfor %}
  {% else %}
  <div class="na">Rail {{ lg.from_name }} &rarr; {{ lg.to_name }}: unavailable<small>{{ lg.error }}{% if lg.source_url %} &bull; <a href="{{ lg.source_url }}">source</a>{% endif %}</small></div>
  {% endif %}
  {% if lg.note %}<div class="est">By train, per Wikivoyage ({{ lg.note.tag }}): {{ lg.note.text }} <a href="{{ lg.note.url }}">source</a></div>{% endif %}
 {% elif lg.rows %}
  {% for r in lg.rows %}
  <div class="row{% if not loop.first %} alt{% endif %}">
   <div class="fn">{{ r.flight }}</div>
   <div><div class="rt">{{ r.from }} {{ r.dep }} &rarr; {{ r.to }} {{ r.arr }}{% if r.next_day %} (+1){% endif %}</div>
    <div class="meta">{{ r.airline }} &bull; {{ lg.date|day }} &bull; {{ r.duration_min|dur }} {% if r.via %}one stop via {{ r.via }}{% else %}nonstop{% endif %}{% if loop.first and lg.used %} &bull; counted in totals{% endif %}{% if loop.first %} &bull; cheapest &bull; live via {{ lg.backend }}, fetched {{ lg.fetched }}{% for a in lg.alts %}{% if a.price %} &bull; via {{ a.iata }}: {{ a.price|money }}{% endif %}{% endfor %}{% endif %}</div></div>
   <div class="pr">{{ r.price|money }}</div>
  </div>
  {% endfor %}
 {% else %}
  <div class="na">{{ lg.orig }} &rarr; {{ lg.dest }} on {{ lg.date|day }}: unavailable<small>{{ lg.error }}</small></div>
 {% endif %}
{% endfor %}

<h3>Stays (Airbnb, entire place, {{ m.people }} guests, total for the stay, 10+ reviews and 4.6+)</h3>
{% for s in o.stops %}
 {% if s.stays %}
  {% for st in s.stays %}
  <div class="row stay{% if not loop.first %} alt{% endif %}">
   <div><div class="rt">{{ s.name }} &bull; {{ s.checkin|short }} to {{ s.checkout|short }} ({{ s.nights }}N){% if loop.first %} &bull; pick{% endif %}</div>
    <div class="meta">{{ st.name }} &bull; {{ st.kind }} &bull; {{ st.rating }} rating, {{ st.reviews }} reviews{% if loop.first %} &bull; live via {{ s.stay_backend }}, fetched {{ s.stay_fetched }}{% endif %}{% if st.badge %} &bull; {{ st.badge }}{% endif %}{% if st.free_cancel %} &bull; free cancellation{% endif %}{% if st.over_budget %} &bull; <span class="est">over the nightly budget: nothing qualifying was within it on these dates</span>{% endif %}</div>
    <a href="{{ st.url }}">{{ st.url }}</a></div>
   <div class="pr">{{ st.total|money }}<div class="meta">{{ st.per_night|money }} a night</div></div>
  </div>
  {% endfor %}
 {% else %}
  <div class="na">{{ s.name }} {{ s.checkin|short }} to {{ s.checkout|short }}: stay unavailable<small>{{ s.stay_error }}</small></div>
 {% endif %}
 {% for st in s.rooms %}
  <div class="row stay alt"><div><div class="rt">Budget private room, {{ s.name }}</div><div class="meta">{{ st.name }} &bull; {{ st.rating }} ({{ st.reviews }})</div><a href="{{ st.url }}">{{ st.url }}</a></div><div class="pr">{{ st.total|money }}</div></div>
 {% endfor %}
 {% for h in s.hostels %}
  <div class="row stay alt"><div><div class="rt">Hostel, {{ s.name }}{% if s.stay_area %} ({{ s.stay_area }}){% endif %}</div>
   <div class="meta">{{ h.name }} &bull; {{ h.rating }}/10, {{ h.reviews }} reviews &bull; live via Hostelworld{% if h.deposit_pct %} &bull; {{ h.deposit_pct }}% deposit online, rest at check-in{% endif %}</div>
   <div class="meta">{% if h.dorms %}dorm bed {{ h.dorms[0].per_night|money }} a night ({{ h.dorms[0].room }}, {{ h.dorms[0].available }} left){% endif %}{% if h.dorms and h.privates %} &bull; {% endif %}{% if h.privates %}private {{ h.privates[0].per_night|money }} a night ({{ h.privates[0].room }}){% endif %}</div>
   <a href="{{ h.url }}">{{ h.url }}</a></div>
   <div class="pr">{% if h.dorms %}{{ h.dorms[0].total|money }}<div class="meta">per bed, {{ h.nights }}N</div>{% elif h.privates %}{{ h.privates[0].total|money }}<div class="meta">room, {{ h.nights }}N</div>{% endif %}</div></div>
 {% endfor %}
{% endfor %}

<h3>Day plan</h3>
<ul class="plan">{% for d in o.days_plan %}<li><b>{{ d.date }}, {{ d.place }}:</b> {{ d.text }}{% if d.extra %} <span class="est">({{ d.extra }})</span>{% endif %}</li>{% endfor %}</ul>

<div class="totals">
<div class="a">Flights {{ o.totals.flights_pp|money }} + stays share {{ o.totals.stays_pp|money }} = {{ o.totals.core_pp|money }} per person (live; rail fares are not read, so legs by train add nothing){% if o.totals.flight_legs_missing or o.totals.rail_fares_missing or o.totals.stays_missing %} (partial: {{ o.totals.flight_legs_missing }} flight leg(s), {{ o.totals.rail_fares_missing }} rail fare(s) and {{ o.totals.stays_missing }} stay(s) unavailable){% endif %}</div>
<div class="b">Ground legs {{ o.totals.ground_lo_pp|money }}&ndash;{{ o.totals.ground_hi_pp|money }} (indicative){% if o.totals.spend_pp is not none %} + daily spend {{ o.totals.spend_pp|money }} (your rates){% else %}, daily spend not included{% endif %} &rarr; all-in about {{ o.totals.all_in_lo_pp|money }} to {{ o.totals.all_in_hi_pp|money }} per person</div>
</div>
</div></div>
{% endfor %}

{% set first = plan.options[0] %}
<h2>Where to stay</h2>
<div class="grid">
{% for s in first.stops %}<div class="card"><h3 style="--c:#F77F00">{{ s.name }}{% if s.airport_km and s.airport_km > 25 %} <span class="est">(nearest airport {{ s.iata }}, {{ s.airport_km }} km)</span>{% endif %}</h3>
{% for a in s.areas %}<p><b>{{ a[0] }}.</b> {{ a[1] }}</p>{% endfor %}
{% if not s.guide_found %}<p class="est">No guide article found for {{ s.name }}.</p>{% endif %}
{% if s.places.sights %}<p><b>See / do:</b> {% for x in s.places.sights %}{{ x.name }}{% if x.price %} ({{ x.price }}){% endif %}{{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
{% for d, items in s.places.diet.items() %}<p><b>{{ d|capitalize }} food:</b> {% if items %}{% for x in items %}{{ x.name }}{{ ", " if not loop.last }}{% endfor %}{% else %}none found in OpenStreetMap or Wikivoyage{% endif %}</p>{% endfor %}
{% if s.places.nightlife %}<p><b>Nightlife:</b> {% for x in s.places.nightlife %}{{ x.name }}{{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
<p class="est">Places from {% for src in s.places_sources %}{{ src.label }} ({{ "ok" if src.ok else "unavailable" }}){{ ", " if not loop.last }}{% endfor %}.</p></div>{% endfor %}
</div>

<h2>Daily spend per person <span class="est">(from your brief's rates, not fetched)</span></h2>
<div class="card">
{% if first.totals.spend_note %}<p class="est">{{ first.totals.spend_note }}</p>{% else %}
{% for r in first.totals.spend_rows %}<div class="kv"><span>{{ r.label }}</span><b>{{ r.amount|money }}</b></div>{% endfor %}
<div class="kv"><span>Total for the trip</span><b>{{ first.totals.spend_pp|money }}</b></div>{% endif %}
{% if plan.fx %}<p class="est">FX: {% for k,v in plan.fx.items() %}1 {{ v.src }} = {{ v.rate }} {{ v.dst }} ({{ v.date }}){{ "; " if not loop.last }}{% endfor %}.</p>{% endif %}
{% if plan.events %}<p><b>In your dates:</b> {% for e in plan.events %}{{ e.text }}{{ "; " if not loop.last }}{% endfor %}</p>{% endif %}
</div>

<h2>Before you go</h2>
<div class="grid">
{% if plan.visa %}<div class="card"><h3 style="--c:#2A9D8F">Visa ({{ m.passport }} passport)</h3>
{% for cc, v in plan.visa.items() %}<p><b>{{ plan.countries[cc] }}:</b> {% if v.status %}{{ v.status }}{% if v.stay %}, stay {{ v.stay }}{% endif %}. {% if v.notes %}{{ v.notes }} {% endif %}<a href="{{ v.source }}">Wikipedia</a>{% if v.revision_ts %}, revision of {{ v.revision_ts[:10] }}{% endif %}. <span class="est">{{ v.verify }}</span>{% else %}unavailable (could not read Wikipedia). <a href="{{ v.source }}">Open the article</a>.{% endif %}</p>{% endfor %}</div>{% endif %}
{% if plan.advisory %}<div class="card"><h3 style="--c:#E63946">Safety advisory ({{ m.passport }} passport)</h3>
{% for cc, a in plan.advisory.items() %}<p><b>{{ plan.countries[cc] }}:</b>
{% for e in a.entries %}{% if e.error %}{{ e.source }}: {{ e.error }}. {% else %}{{ e.source }}: {% if e.tag %}<span class="lvl">{{ e.tag }}</span> {% endif %}{{ e.text }} <a href="{{ e.url }}">source</a>{% if e.updated %} (updated {{ e.updated }}){% endif %}. {% endif %}{% endfor %}</p>{% endfor %}
{% for a in plan.advisory.values() %}{% if loop.first and a.note %}<p class="est">{{ a.note }}</p>{% endif %}{% endfor %}</div>{% endif %}
<div class="card"><h3 style="--c:#7B2CBF">Climate in {{ first.start|day }}'s month</h3>
{% for k, c in plan.climate.items() %}<p><b>{{ k }}:</b> {% if c.day_high_c is defined %}{{ c.day_high_c }}&deg;C day, {{ c.night_low_c }}&deg;C night, {{ c.rain_mm }} mm rain over {{ c.rain_days }} days{% if c.sunshine_h %}, {{ c.sunshine_h }} h sun a day{% endif %}. <b>{{ c.warning }}.</b> <span class="est">average of the last {{ c.years }} years, <a href="{{ c.url }}">Open-Meteo</a></span>{% else %}unavailable. {{ c.error }}{% endif %}</p>{% endfor %}
<p class="est">Forecast: {% set w = plan.weather.values()|list %}{% if w and w[0] is mapping and w[0].error %}not available yet, the trip is beyond the 16-day forecast window.{% else %}see evidence folder.{% endif %}</p></div>
</div>

{% set shown = [] %}
{% for k, ph in plan.photos.items() %}{% if ph %}{% set _ = shown.append(1) %}{% endif %}{% endfor %}
{% if shown %}
<h2>Places</h2>
<div class="photos">
{% for k, ph in plan.photos.items() %}{% for p in ph[:1] %}<figure><img alt="{{ k }}" src="data:image/jpeg;base64,{{ p.b64 }}"><figcaption>{{ k }}: {{ p.credit }} via <a href="{{ p.page }}">Wikimedia Commons</a></figcaption></figure>{% endfor %}{% endfor %}
</div>
{% endif %}

{% if plan.not_applicable %}<h2>Not applicable to this trip</h2>
<div class="card">{% for r in plan.not_applicable %}<p class="est">not applicable: {{ r }}</p>{% endfor %}</div>{% endif %}

<h2>Evidence</h2>
<div class="card"><table class="ev"><tr><th>Fetch</th><th>Status</th><th>When</th><th>Source</th><th>File</th></tr>
{% for e in plan.evidence %}<tr><td>{{ e.label }}</td><td class="{{ 'ok' if e.ok else 'bad' }}">{{ "ok" if e.ok else "unavailable" }}</td><td>{{ e.fetched_at }}</td>
<td>{% if e.url %}<a href="{{ e.url }}">link</a>{% endif %}{% if e.error %} {{ e.error }}{% endif %}</td>
<td>{% if e.file %}<a href="../evidence/{{ e.file }}">{{ e.file }}</a>{% endif %}{% if e.cached %} (cache){% endif %}</td></tr>{% endfor %}
</table>
<p class="est">Flight and stay prices are live page reads at the time shown and change quickly. Open the source link before booking.</p></div>
</div></body></html>
